---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import PackageCard from './PackageCard.astro';
import References from './References.astro';
import { services, icons, type ServiceKey } from '../data/services';
import { byCategory, categories, type Category } from '../data/packages';
interface Props { slug: ServiceKey }
const s = services[Astro.props.slug];
const catMap: Record<string, Category[]> = { webdesign: ['webdesign', 'abo', 'pflege'], logodesign: ['logodesign', 'bundle'], seo: ['seo', 'bewertung'], sea: ['sea'], software: ['software'], barrierefreiheit: ['bfsg'], bewertungskarten: ['bewertung'] };
const pkgGroups = catMap[Astro.props.slug].map((c) => ({ cat: categories.find((x) => x.id === c)!, items: byCategory(c) }));
const refFilter = ({ webdesign: ['webdesign', 'shop'], logodesign: ['logodesign'], seo: ['seo'], sea: ['sea'], software: ['software'], barrierefreiheit: [], bewertungskarten: [] } as const)[Astro.props.slug];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  provider: { '@id': 'https://schmitzwebart.de/#business' },
  areaServed: ['Hilden', 'Düsseldorf', 'Deutschland'],
  description: s.metaDescription,
};
---
<Base title={s.metaTitle} description={s.metaDescription} schema={schema}>
  <PageHero eyebrow={s.name} title={s.heroTitle} text={s.heroText}>
    <div class="hero-actions"><a class="btn btn--primary" href="/kontakt">Unverbindlich anfragen</a><a class="btn btn--ghost" href="#pakete">Pakete ansehen</a></div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Ihre Vorteile</span><h2>Darum {s.name} von der Webmanufaktur</h2></div>
      <div class="grid grid--4">
        {s.benefits.map((b) => (
          <div class="card card--hover">
            <div class="icon-badge"><svg viewBox="0 0 24 24" set:html={icons[b.icon]} /></div>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <slot />

  <section class="section section--alt">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Ablauf</span><h2>So arbeiten wir zusammen</h2></div>
      <ol class="steps">
        {s.steps.map(([t, d], i) => (
          <li class="card"><span class="step-n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <References filter={[...refFilter]} title={`${s.name}: Referenzen`} />

  <section class="section section--alt" id="pakete">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Pakete</span><h2>Für jedes Budget das passende Paket</h2><p class="lead">Vom günstigen Einstieg bis zur Premium-Lösung, alle Preise netto. Nichts dabei? Ich mache Ihnen ein individuelles Angebot.</p></div>
      {pkgGroups.map((g, i) => (
        <div class="pkg-group">
          {pkgGroups.length > 1 && <div class="pkg-group-head"><h3>{g.cat.label}</h3><p>{g.cat.intro}</p></div>}
          <div class="grid pkg-grid">{g.items.map((p) => <PackageCard pkg={p} />)}</div>
        </div>
      ))}
      <p class="pkg-more"><a class="btn btn--ghost" href="/pakete#rechner">Preis selbst berechnen</a> <a class="btn btn--ghost" href="/pakete">Alle Pakete vergleichen</a></p>
    </div>
  </section>

  <Faq items={s.faq} />
  <CtaBand />
</Base>
<style>
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .pkg-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .pkg-group + .pkg-group { margin-top: 3.5rem; }
  .pkg-group-head { margin-bottom: 1.8rem; }
  .pkg-group-head h3 { font-size: 1.5rem; font-weight: 700; margin-bottom: .3rem; }
  .pkg-group-head p { margin: 0; max-width: 70ch; }
  .pkg-more { margin-top: 2.2rem; display: flex; flex-wrap: wrap; gap: .8rem; }
  .step-n { font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; display: block; margin-bottom: .4rem; }
</style>
