---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Häufige Fragen' } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) };
---
<section class="section">
  <div class="container faq-wrap">
    <div class="section-head"><span class="eyebrow">FAQ</span><h2>{title}</h2></div>
    <div class="faq">
      {items.map((i) => (
        <details>
          <summary>{i.q}</summary>
          <p>{i.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
<style>
  .faq-wrap { max-width: 820px; }
  details { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); margin-bottom: .8rem; }
  summary { cursor: pointer; padding: 1.1rem 1.4rem; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 1rem; color: var(--text); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--blue); font-size: 1.4rem; line-height: 1; transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { padding: 0 1.4rem 1.2rem; margin: 0; }
</style>
