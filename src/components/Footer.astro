---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { cities } from '../data/cities';
const year = new Date().getFullYear();
const group = (label: string) => (site.nav.find((n) => n.label === label && 'children' in n) as { children: { href: string; label: string }[] } | undefined)?.children ?? [];
const leistungen = group('Leistungen');
const branchenLinks = group('Branchen');
---
<footer class="ftr">
  <div class="container ftr-grid">
    <div>
      <Logo />
      <p class="ftr-about">{site.name}: Webdesign, Logodesign, SEO, Google Ads und individuelle Software aus einer Hand. Persönlich, schnell und mit festen Preisen.</p>
    </div>
    <div>
      <h2 class="ftr-h">Leistungen</h2>
      <ul>{leistungen.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="ftr-h">Branchen & mehr</h2>
      <ul>
        {branchenLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/pakete">Pakete & Preise</a></li>
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/ratgeber">Ratgeber</a></li>
        <li><a href="/ueber-mich">Über mich</a></li>
        <li><a href="/empfehlen">Empfehlen & Gutschrift</a></li>
      </ul>
    </div>
    <div>
      <h2 class="ftr-h">Webdesign in Ihrer Nähe</h2>
      <ul class="ftr-cities">
        {cities.map((c) => <li><a href={`/webdesign-${c.slug}`}>{c.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="ftr-h">Kontakt</h2>
      <address>
        {site.name}<br />
        {site.address.street}<br />
        {site.address.zip} {site.address.city}<br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.phone && (<><br /><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></>)}
      </address>
      <a class="btn btn--ghost btn--sm" href="/seo-check">Kostenloser Website-Check</a>
    </div>
  </div>
  <p class="container ftr-b2b">Alle Preise netto zzgl. gesetzlicher MwSt. Meine Angebote richten sich an Unternehmen, Selbstständige, Vereine und Institutionen.</p>
  <div class="container ftr-bottom">
    <span>© {year} {site.name} · Inhaber {site.owner}</span>
    <span class="ftr-legal"><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a><a href="/agb">AGB</a><a href="/barrierefreiheit-erklaerung">Barrierefreiheit</a><button type="button" data-cookie-settings hidden>Cookie-Einstellungen</button></span>
  </div>
</footer>
<style>
  .ftr { border-top: 1px solid var(--line); background: var(--bg-2); padding-top: 4rem; margin-top: 2rem; }
  .ftr-grid { display: grid; gap: 2.5rem; grid-template-columns: 1.3fr 1fr 1fr 1fr 1.2fr; padding-bottom: 3rem; }
  .ftr-about { margin-top: 1rem; font-size: .95rem; max-width: 34ch; }
  .ftr .ftr-h { font-size: .85rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text); margin-bottom: 1rem; }
  .ftr li { margin-bottom: .5rem; }
  .ftr-cities { display: grid; grid-template-columns: 1fr 1fr; column-gap: 1rem; }
  .ftr li a, .ftr address a { color: var(--muted); transition: color .2s; }
  .ftr li a:hover, .ftr address a:hover { color: #fff; }
  address { font-style: normal; color: var(--muted); margin-bottom: 1rem; line-height: 1.7; }
  .ftr-b2b { font-size: .82rem; color: var(--muted); margin: 0 auto 1rem; }
  .ftr-bottom { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; padding: 1.5rem 0 2rem; border-top: 1px solid var(--line); font-size: .88rem; color: var(--muted); }
  .ftr-legal { display: flex; flex-wrap: wrap; gap: .6rem 1.4rem; }
  .ftr-legal a:hover, .ftr-legal button:hover { color: #fff; }
  .ftr-legal button { background: none; border: 0; color: inherit; font: inherit; cursor: pointer; padding: 0; }
  @media (max-width: 1080px) { .ftr-grid { grid-template-columns: 1fr 1fr 1fr; } }
  @media (max-width: 760px) { .ftr-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .ftr-grid { grid-template-columns: 1fr; } }
</style>
