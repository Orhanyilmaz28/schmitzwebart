---
import { references, serviceLabels, type Ref } from '../data/references';
interface Props { filter?: Ref['services'][number][]; title?: string; eyebrow?: string; alt?: boolean; showAll?: boolean }
const { filter, title = 'Projekte, die online sind', eyebrow = 'Referenzen', alt = false, showAll = true } = Astro.props;
const list = filter ? references.filter((r) => r.services.some((s) => filter.includes(s))) : references;
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---
{list.length > 0 && (
<section class:list={['section', { 'section--alt': alt }]}>
  <div class="container">
    <div class="section-head"><span class="eyebrow">{eyebrow}</span><h2>{title}</h2></div>
    <div class="grid grid--2">
      {list.map((r) => (
        <a class="card card--hover ref" href={r.url} target="_blank" rel="noopener">
          <div class="ref-thumb" style={`--h:${r.hue}`} aria-hidden="true">
            <div class="ref-bar"><i></i><i></i><i></i><span>{host(r.url)}</span></div>
            <div class="ref-body">
              <span class="ref-name">{r.name}</span>
              <span class="ref-lines"><b></b><b></b></span>
            </div>
          </div>
          <div class="ref-meta">
            <div>{r.services.map((s) => <span class="tag">{serviceLabels[s]}</span>)}</div>
            <h3>{r.name}</h3>
            <p>{r.text}</p>
            <span class="ref-link">{host(r.url)} ansehen ↗</span>
          </div>
        </a>
      ))}
    </div>
    {showAll && <p style="margin-top:1.6rem"><a class="btn btn--ghost" href="/portfolio">Zum Portfolio</a></p>}
  </div>
</section>
)}
<style>
  .ref { padding: 1rem; display: flex; flex-direction: column; }
  .ref-thumb { border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: linear-gradient(160deg, hsl(var(--h) 55% 20%), #0b0d1d 75%); }
  .ref-bar { display: flex; align-items: center; gap: 5px; padding: .55rem .8rem; background: rgba(0,0,0,.35); border-bottom: 1px solid var(--line); }
  .ref-bar i { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.2); }
  .ref-bar span { margin-left: .6rem; font-size: .72rem; color: var(--muted); background: rgba(255,255,255,.06); padding: .1rem .7rem; border-radius: 999px; }
  .ref-body { aspect-ratio: 16 / 8; display: grid; place-content: center; justify-items: center; gap: .9rem; background: radial-gradient(circle at 50% 30%, hsl(var(--h) 90% 60% / .35), transparent 65%); }
  .ref-name { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 3vw, 2.3rem); letter-spacing: -.03em; color: #fff; }
  .ref-lines { display: grid; gap: .4rem; justify-items: center; }
  .ref-lines b { display: block; height: 7px; width: 160px; border-radius: 4px; background: rgba(255,255,255,.14); }
  .ref-lines b + b { width: 110px; }
  .ref-meta { padding: 1.2rem .6rem .4rem; }
  .ref-meta h3 { margin-top: .4rem; font-size: 1.35rem; font-weight: 700; }
  .ref-link { color: var(--blue); font-weight: 600; font-size: .95rem; }
</style>
