---
import { testimonials } from '../data/testimonials';
interface Props { alt?: boolean }
const { alt = true } = Astro.props;
---
{testimonials.length > 0 && (
  <section class:list={['section', { 'section--alt': alt }]}>
    <div class="container">
      <div class="section-head center"><span class="eyebrow">Kundenstimmen</span><h2>Das sagen meine Kunden</h2></div>
      <div class="grid grid--3">
        {testimonials.map((t) => (
          <figure class="card tst">
            {t.stars && <div class="tst-stars" aria-label={`${t.stars} von 5 Sternen`}>{'★'.repeat(t.stars)}<span>{'★'.repeat(5 - t.stars)}</span></div>}
            <blockquote>„{t.quote}“</blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.role}{t.project && ` · ${t.project}`}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .tst { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .tst-stars { color: #ffc24d; letter-spacing: .15em; } .tst-stars span { color: rgba(255,255,255,.2); }
  .tst blockquote { margin: 0; font-size: 1.05rem; line-height: 1.6; color: var(--text); flex: 1; }
  .tst figcaption strong { display: block; color: var(--text); }
  .tst figcaption span { color: var(--muted); font-size: .9rem; }
</style>
