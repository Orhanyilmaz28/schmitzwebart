---
interface Props { title?: string; text?: string; label?: string; href?: string }
const { title = 'Bereit für den nächsten Schritt?', text = 'Schreiben Sie uns kurz, worum es geht. Sie erhalten innerhalb eines Werktags eine Antwort mit einem klaren Vorschlag.', label = 'Unverbindlich anfragen', href = '/kontakt' } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta">
      <div class="glow"></div>
      <div class="relative">
        <h2>{title}</h2>
        <p class="lead">{text}</p>
        <a class="btn btn--primary" href={href}>{label}</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 28px; padding: clamp(2.2rem, 6vw, 4.5rem); text-align: center; background: var(--surface); }
  .cta .lead { margin: 0 auto 1.8rem; }
  .cta :global(.glow::before), .cta :global(.glow::after) { opacity: .22; width: 380px; height: 380px; }
</style>
