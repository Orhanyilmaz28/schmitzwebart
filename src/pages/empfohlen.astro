---
import Base from '../layouts/Base.astro';
import BranchenGrid from '../components/BranchenGrid.astro';
import { contactLinks } from '../data/site';
import { Image } from 'astro:assets';
import photo from '../assets/phillip-schmitz.jpg';
const ext = contactLinks.bookingExternal ? { target: '_blank', rel: 'noopener' } : {};
---
<Base title="Sie wurden empfohlen" description="Sie wurden an die Webmanufaktur Schmitz empfohlen: Websites, Logos, SEO, Google Ads und Software zum Festpreis aus Hilden." noindex>
  <section class="rec">
    <div class="glow"></div>
    <div class="container relative rec-grid">
      <div>
        <span class="eyebrow">Persönliche Empfehlung</span>
        <h1><span class="rec-who">Jemand</span> empfiehlt Ihnen die Webmanufaktur Schmitz.</h1>
        <p class="lead">Schön, dass Sie hier sind! Ich bin Phillip Schmitz und gestalte Websites, Logos und Software für Unternehmen, Selbstständige und Vereine, persönlich und zum Festpreis.</p>
        <div class="acts">
          <a class="btn btn--primary rec-contact" href="/kontakt?paket=beratung">Unverbindlich anfragen</a>
          <a class="btn btn--ghost" href={contactLinks.booking} {...ext}>Kostenloses Erstgespräch</a>
        </div>
        <p class="small">Ihr Empfehlungsgeber wird bei Ihrer Anfrage automatisch genannt. Für Sie entstehen dadurch keine Kosten.</p>
      </div>
      <div class="rec-photo"><Image src={photo} alt="Phillip Schmitz" width={420} height={525} /></div>
    </div>
  </section>
  <section class="section section--alt">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Was ich mache</span><h2>Pakete für Ihre Branche</h2></div>
      <BranchenGrid />
      <p style="margin-top:2rem"><a class="btn btn--ghost" href="/pakete">Alle Pakete & Preise</a> <a class="btn btn--ghost" href="/portfolio">Referenzen ansehen</a></p>
    </div>
  </section>
</Base>
<style>
  .rec { position: relative; overflow: hidden; padding: clamp(3rem, 7vw, 5.5rem) 0; }
  .rec-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .rec-who { background: linear-gradient(120deg, #ffc24d, #ff4f8b); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .acts { display: flex; flex-wrap: wrap; gap: .8rem; margin: 1.6rem 0 1rem; }
  .small { font-size: .88rem; }
  .rec-photo :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 15%; border-radius: 26px; border: 2px solid rgba(164, 91, 255, .5); }
  @media (max-width: 860px) { .rec-grid { grid-template-columns: 1fr; } .rec-photo { max-width: 340px; } }
</style>
<script>
  const von = (new URLSearchParams(location.search).get('von') || '').trim().slice(0, 120);
  if (von) {
    document.querySelector('.rec-who')!.textContent = von;
    document.querySelector<HTMLAnchorElement>('.rec-contact')!.href = `/kontakt?paket=beratung&von=${encodeURIComponent(von)}`;
  }
</script>
