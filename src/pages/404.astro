---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden" noindex>
  <section class="section center">
    <div class="container">
      <span class="eyebrow">Fehler 404</span>
      <h1>Diese Seite gibt es nicht.</h1>
      <p class="lead">Vielleicht hat sich die Adresse geändert. Hier geht es zurück zum Start.</p>
      <p><a class="btn btn--primary" href="/">Zur Startseite</a></p>
    </div>
  </section>
</Base>
