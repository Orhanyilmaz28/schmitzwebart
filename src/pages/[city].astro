---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PackageCard from '../components/PackageCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { cities } from '../data/cities';
import { packages } from '../data/packages';
import { site } from '../data/site';
export function getStaticPaths() {
  return cities.map((c) => ({ params: { city: `webdesign-${c.slug}` }, props: { c } }));
}
const { c } = Astro.props;
const pkgs = packages.filter((p) => ['one-pager', 'business-website', 'start-bundle'].includes(p.slug));
const schema = { '@context': 'https://schema.org', '@type': 'Service', name: `Webdesign ${c.name}`, provider: { '@id': `${site.url}/#business` }, areaServed: { '@type': 'City', name: c.name } };
---
<Base title={`Webdesign ${c.name}: Websites vom Profi`} description={`Webdesign in ${c.name}: Individuelle, schnelle Websites mit SEO-Grundlage zum Festpreis von der Webmanufaktur Schmitz (Hilden).`} schema={schema}>
  <PageHero eyebrow={`Webdesign ${c.name}`} title={`Webdesign in ${c.name}, das Anfragen bringt.`} text={c.intro}>
    <div style="display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.8rem"><a class="btn btn--primary" href="/kontakt">Unverbindlich anfragen</a><a class="btn btn--ghost" href="/webdesign">Alle Webdesign-Infos</a></div>
  </PageHero>
  <section class="section">
    <div class="container two">
      <div>
        <span class="eyebrow">Ihr Vorteil</span>
        <h2>Ihr Partner für Websites in {c.name}</h2>
        <p class="lead">Wir verbinden Design, Technik und Suchmaschinenoptimierung. Ihre Seite sieht nicht nur gut aus, sie wird auch gefunden.</p>
      </div>
      <ul class="check-list card">{c.points.map((p) => <li>{p}</li>)}</ul>
    </div>
  </section>
  <section class="section section--alt">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Pakete</span><h2>Webdesign-Pakete für {c.name}</h2></div>
      <div class="grid grid--3">{pkgs.map((p) => <PackageCard pkg={p} />)}</div>
    </div>
  </section>
  <CtaBand title={`Website für ${c.name}? Sprechen wir darüber.`} />
</Base>
<style>
  .two { display: grid; gap: 2.5rem; grid-template-columns: 1.2fr 1fr; align-items: center; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
</style>
