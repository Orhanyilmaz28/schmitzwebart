---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles, readingTime, fmtDate } from '../../lib/ratgeber';
import { site, contactLinks } from '../../data/site';
import photo from '../../assets/phillip-schmitz.jpg';
export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((a) => ({ params: { slug: a.id }, props: { a, more: all.filter((x) => x.id !== a.id).slice(0, 3) } }));
}
const { a, more } = Astro.props;
const { Content } = await render(a);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.data.title,
  description: a.data.description,
  datePublished: a.data.date.toISOString(),
  author: { '@type': 'Person', name: site.owner, url: `${site.url}/ueber-mich` },
  publisher: { '@id': `${site.url}/#business` },
  mainEntityOfPage: `${site.url}/ratgeber/${a.id}`,
};
---
<Base title={a.data.seoTitle ?? a.data.title} description={a.data.description} schema={schema}>
  <article class="section">
    <div class="container art-wrap">
      <nav class="crumbs" aria-label="Brotkrumen"><a href="/ratgeber">Ratgeber</a> / <span>{a.data.category}</span></nav>
      <h1>{a.data.title}</h1>
      <div class="byline">
        <Image src={photo} alt="" width={96} height={96} class="by-img" />
        <span>Von <a href="/ueber-mich">{site.owner}</a> · {fmtDate(a.data.date)} · {readingTime(a.body)} Min. Lesezeit</span>
      </div>
      <div class="prose art-body"><Content /></div>
      <aside class="art-cta card">
        <div>
          <strong>Kostenlos und unverbindlich</strong>
          <p>Fragen zum Thema? Im 15-minütigen Erstgespräch bekommen Sie eine ehrliche Einschätzung für Ihren Fall.</p>
        </div>
        <div class="art-cta-btns">
          <a class="btn btn--primary" href={a.data.cta.href}>{a.data.cta.label}</a>
          <a class="btn btn--ghost" href={contactLinks.booking}>Erstgespräch vereinbaren</a>
        </div>
      </aside>
    </div>
  </article>
  <section class="section section--alt">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Weiterlesen</span><h2>Mehr aus dem Ratgeber</h2></div>
      <div class="grid grid--3">{more.map((m) => <ArticleCard a={m} />)}</div>
    </div>
  </section>
</Base>
<style>
  .art-wrap { max-width: 780px; }
  .crumbs { font-size: .85rem; color: var(--muted); margin-bottom: 1rem; } .crumbs a { color: var(--blue); }
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); }
  .byline { display: flex; align-items: center; gap: .8rem; color: var(--muted); font-size: .92rem; margin: 1.2rem 0 2rem; }
  .byline a { color: var(--text); font-weight: 600; }
  .byline :global(.by-img) { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: 50% 15%; }
  .art-body { max-width: none; font-size: 1.08rem; }
  .art-body :global(h2) { margin-top: 2.4rem; }
  .art-body :global(strong) { color: var(--text); }
  .art-body :global(ol), .art-body :global(ul) { padding-left: 1.3rem; margin-bottom: 1rem; }
  .art-body :global(li) { margin-bottom: .4rem; color: var(--muted); }
  .art-body :global(table) { width: 100%; border-collapse: collapse; margin: 1.4rem 0; font-size: .95rem; display: block; overflow-x: auto; }
  .art-body :global(th), .art-body :global(td) { text-align: left; padding: .7rem .8rem; border-bottom: 1px solid var(--line); color: var(--muted); }
  .art-body :global(th) { color: var(--text); background: var(--surface); }
  .art-cta { margin-top: 3rem; display: grid; gap: 1rem; border-color: rgba(164, 91, 255, .5); }
  .art-cta strong { color: var(--text); font-size: 1.1rem; }
  .art-cta p { margin: .3rem 0 0; }
  .art-cta-btns { display: flex; flex-wrap: wrap; gap: .7rem; }
</style>
