---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import PackageCard from '../components/PackageCard.astro';
import { services, icons } from '../data/services';
import { packages } from '../data/packages';
import { faqGeneral } from '../data/faq';
import { site, contactLinks } from '../data/site';
import Founder from '../components/Founder.astro';
import Testimonials from '../components/Testimonials.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/ratgeber';
const latest = (await getArticles()).slice(0, 3);
import References from '../components/References.astro';
import Marquee from '../components/Marquee.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import { Image } from 'astro:assets';
import photo from '../assets/phillip-schmitz.jpg';
const featured = packages.filter((p) => p.category === 'bundle');
const ladder = [
  { k: 'Klein starten', v: 149, pre: 'ab', unit: '€', t: 'Logo Express, Visitenkarte-Website ab 390 €, Starter-Paket 490 €', href: '/pakete#bundle' },
  { k: 'Ohne Anzahlung', v: 49, pre: 'ab', unit: '€ / Monat', t: 'Website-Abo inkl. Hosting, Domain & Pflege, ohne Investition auf einen Schlag', href: '/pakete#abo' },
  { k: 'Richtig durchstarten', v: 1990, pre: '', unit: '€', t: 'Business-Website, Start-Bundle mit Logo & SEO für 2.690 €', href: '/pakete#webdesign' },
  { k: 'Premium & Individuell', v: 5990, pre: 'ab', unit: '€', t: 'Komplett-Paket, große Shops, Portale und Software nach Maß', href: '/pakete#software' },
];
const why = [
  { icon: 'chat', t: 'Persönlich', d: 'Sie sprechen direkt mit dem Inhaber, ohne Callcenter und ohne Weitergabe.' },
  { icon: 'tag', t: 'Feste Preise', d: 'Klare Pakete mit Leistungsumfang. Sie wissen vorher, was es kostet.' },
  { icon: 'speed', t: 'Schnell & modern', d: 'Statische Websites mit Top-Ladezeiten, die Google und Besucher lieben.' },
  { icon: 'pin', t: 'Aus der Region', d: 'Sitz in Hilden, aktiv in Düsseldorf, im Kreis Mettmann und bundesweit.' },
];
---
<Base title="Webdesign, Logodesign & SEO in Hilden | schmitzwebart" description={site.description}>
  <section class="hero">
    <div class="glow"></div>
    <div class="container relative hero-grid">
      <div>
        <span class="eyebrow reveal">Webmanufaktur Schmitz · Hilden</span>
        <h1 class="reveal">Websites, Logos und <span class="grad-text">Sichtbarkeit</span>, die Kunden bringen.</h1>
        <p class="lead reveal">Ich gestalte Ihren kompletten Online-Auftritt aus einer Hand: Webdesign, Logodesign, SEO und Google Ads. Dazu individuelle Windows-Software. Für jedes Budget, vom Logo für 149 € bis zur Software nach Maß.</p>
        <div class="hero-actions reveal">
          <a class="btn btn--primary" href={contactLinks.booking} {...(contactLinks.bookingExternal ? { target: '_blank', rel: 'noopener' } : {})}>Kostenloses Erstgespräch</a>
          <a class="btn btn--ghost" href="/pakete">Pakete ansehen</a>
        </div>
        <p class="hero-for reveal">Für <span class="hero-rot" data-rotate="Handwerker|Praxen|Vereine|Online-Shops|Gastronomie|Startups|Dienstleister|Callcenter">Handwerker</span> in Hilden und ganz Deutschland.</p>
        <ul class="hero-trust reveal">
          <li>✓ 15 Minuten, unverbindlich</li><li>✓ Festpreis-Pakete</li><li>✓ Antwort in 1 Werktag</li>
        </ul>
      </div>
      <div class="hero-visual reveal" aria-hidden="true">
        <div class="hero-orb"></div>
        <img class="hero-icon" src="/logo-mark.svg" width="460" height="460" alt="" />
        <div class="badge b1"><strong>✓</strong><span>Datenschutz-<br/>freundlich</span></div>
        <div class="badge b2"><strong>⚡</strong><span>Schnell &amp;<br/>SEO-ready</span></div>
        <a class="badge b3" href="#inhaber" tabindex="-1"><Image src={photo} alt="" width={88} height={88} class="b3-img" /><span><b>Phillip Schmitz</b><br/>Persönlich vom Inhaber</span></a>
      </div>
    </div>
  </section>
  <Marquee />

  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Leistungen</span><h2>Alles, was Ihr Auftritt braucht</h2><p class="lead">Leistungen, die ineinandergreifen: eine Marke, die auffällt, eine Seite, die überzeugt, Kunden, die Sie finden, und Software, die Ihnen Arbeit abnimmt.</p></div>
      <div class="grid services-grid">
        {Object.values(services).map((s) => (
          <a class="card" href={s.path}>
            <div class="icon-badge"><svg viewBox="0 0 24 24" set:html={icons[s.icon]} /></div>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="more">Mehr erfahren →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head center"><span class="eyebrow">Für jedes Budget</span><h2>Vom kleinen Start bis zur großen Lösung</h2><p class="lead">Sie entscheiden, wie groß Sie einsteigen. Jedes Paket lässt sich später erweitern, ohne von vorn anzufangen.</p></div>
      <ol class="ladder">
        {ladder.map((l, i) => (
          <li class="ladder-step">
            <a href={l.href} class="ladder-card">
              <span class="ladder-n">0{i + 1}</span>
              <span class="ladder-k">{l.k}</span>
              <span class="ladder-p">{l.pre} <b data-count={l.v}>{new Intl.NumberFormat('de-DE').format(l.v)}</b> {l.unit}</span>
              <span class="ladder-t">{l.t}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="center" style="margin-top:2.2rem"><a class="btn btn--primary" href="/pakete#rechner">Preis in 1 Minute berechnen</a></p>
    </div>
  </section>

  <References />
  <Testimonials alt={false} />

  <section class="section section--alt">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Fertige Software</span><h2>Programme, die man einmal kauft</h2><p class="lead">Vereinsverwaltung, Callcenter, Kundenverwaltung und Zeiterfassung: lokal auf Ihren Windows-Rechnern, ohne Abo. Oder Software nach Maß zum Festpreis.</p></div>
      <ProductShowcase compact />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center"><span class="eyebrow">Warum Webmanufaktur Schmitz</span><h2>Handwerk statt Massenware</h2></div>
      <div class="grid grid--4">
        {why.map((w) => (
          <div class="card">
            <div class="icon-badge"><svg viewBox="0 0 24 24" set:html={icons[w.icon]} /></div>
            <h3>{w.t}</h3><p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Founder />

  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Kombi-Pakete</span><h2>Alles aus einer Hand, günstiger als einzeln</h2><p class="lead">Drei Kombinationen von klein bis groß, alle Preise netto zzgl. MwSt. Weitere Pakete finden Sie in der Übersicht.</p></div>
      <div class="grid grid--3">{featured.map((p) => <PackageCard pkg={p} />)}</div>
      <p class="center" style="margin-top:2rem"><a class="btn btn--ghost" href="/pakete">Alle Pakete ansehen</a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container check-box">
      <div>
        <span class="eyebrow">Kostenloser Website-Check</span>
        <h2>Wie gut ist Ihre Website wirklich?</h2>
        <p class="lead">Über 20 Prüfpunkte zu Ladezeit, mobiler Darstellung, SEO und Rechtlichem. Das Ergebnis sehen Sie sofort, kostenlos und ohne Anmeldung.</p>
        <form class="quick-check" action="/seo-check" method="get">
          <label for="qc-url" class="sr-only">Ihre Website</label>
          <input id="qc-url" name="url" type="text" inputmode="url" placeholder="ihre-website.de" required />
          <button class="btn btn--primary" type="submit">Jetzt prüfen</button>
        </form>
      </div>
      <ul class="check-list">
        <li>Ladezeit und Core Web Vitals</li>
        <li>Darstellung auf Smartphone & Tablet</li>
        <li>Grundlagen für Google (SEO)</li>
        <li>Vertrauenssignale & Rechtliches</li>
        <li>Rechtliches: Impressum & Datenschutz</li>
        <li>Konkrete Verbesserungsvorschläge</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Ratgeber</span><h2>Wissen, das Ihnen Geld und Zeit spart</h2></div>
      <div class="grid grid--3">{latest.map((a) => <ArticleCard a={a} />)}</div>
      <p style="margin-top:1.8rem"><a class="btn btn--ghost" href="/ratgeber">Alle Artikel</a></p>
    </div>
  </section>

  <Faq items={faqGeneral} />
  <CtaBand title="Lassen Sie uns über Ihr Projekt sprechen" />
</Base>
<style>
  .hero { position: relative; padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(3rem, 7vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 3rem; grid-template-columns: 1.15fr .85fr; align-items: center; }
  .hero h1 { margin-bottom: 1.2rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin: 2rem 0 1.5rem; }
  .hero-for { font-size: 1.05rem; color: var(--muted); margin: -.4rem 0 0; }
  .hero-rot { color: var(--text); font-weight: 700; background: linear-gradient(120deg, #ffc24d, #ff4f8b); -webkit-background-clip: text; background-clip: text; color: transparent; min-width: 8ch; }
  .ladder { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; position: relative; }
  .ladder::before { content: ''; position: absolute; left: 4%; right: 4%; top: 2.1rem; height: 2px; background: linear-gradient(90deg, #ff9a4d, #ff4f8b, #a45bff, #4f8cff); opacity: .5; }
  .ladder-step { position: relative; }
  .ladder-step:nth-child(2) { margin-top: 1.2rem; } .ladder-step:nth-child(3) { margin-top: 2.4rem; } .ladder-step:nth-child(4) { margin-top: 3.6rem; }
  .ladder-card { display: grid; gap: .45rem; height: 100%; padding: 1.4rem; border-radius: var(--radius); border: 1px solid var(--line); background: linear-gradient(180deg, var(--surface), rgba(17,20,42,.5)); transition: transform .25s, border-color .25s, box-shadow .25s; }
  .ladder-card:hover { transform: translateY(-6px); border-color: rgba(164, 91, 255, .6); box-shadow: 0 30px 60px -30px rgba(164, 91, 255, .6); }
  .ladder-n { width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; background: var(--bg-2); border: 2px solid rgba(164, 91, 255, .6); color: #fff; margin-top: -2.7rem; }
  .ladder-k { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--text); }
  .ladder-p { font-size: .95rem; color: var(--muted); }
  .ladder-p b { font-family: var(--font-display); font-size: 2.1rem; color: var(--text); background: linear-gradient(120deg, #fff, #c9b8ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ladder-t { font-size: .9rem; color: var(--muted); }
  @media (max-width: 900px) { .ladder { grid-template-columns: 1fr 1fr; } .ladder::before { display: none; } .ladder-step:nth-child(n) { margin-top: 1.6rem; } }
  @media (max-width: 520px) { .ladder { grid-template-columns: 1fr; } }
  .hero-trust { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; color: var(--muted); font-size: .92rem; }
  .hero-visual { position: relative; }
  .hero-orb { position: absolute; inset: 8% 6%; border-radius: 50%; background: radial-gradient(circle at 45% 40%, rgba(164, 91, 255, .45), rgba(79, 140, 255, .18) 50%, transparent 70%); filter: blur(8px); }
  .hero-icon { position: relative; width: min(100%, 460px); height: auto; margin-inline: auto; filter: drop-shadow(0 40px 70px rgba(80, 60, 200, .45)); }
  @media (prefers-reduced-motion: no-preference) { .hero-icon { animation: float 7s ease-in-out infinite; } @keyframes float { 50% { transform: translateY(-12px); } } }
  .badge { position: absolute; display: flex; align-items: center; gap: .6rem; background: rgba(17, 20, 42, .92); border: 1px solid var(--line); border-radius: 14px; padding: .6rem .9rem; backdrop-filter: blur(8px); }
  .badge strong { font-family: var(--font-display); font-size: 1.5rem; }
  .badge span { font-size: .7rem; color: var(--muted); line-height: 1.2; }
  .b1 { left: 0; top: 18%; } .b2 { right: 0; top: 4%; }
  .b3 { right: 4%; bottom: 2%; padding: .5rem .9rem .5rem .5rem; }
  .b3 :global(.b3-img) { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: 50% 15%; border: 2px solid rgba(255,255,255,.2); }
  .b3 span { font-size: .75rem; } .b3 b { color: var(--text); font-size: .85rem; }
  .services-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .more { color: var(--blue); font-weight: 600; font-size: .95rem; }
  .quick-check { display: flex; gap: .5rem; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: .4rem; max-width: 520px; margin-top: 1.5rem; }
  .quick-check input { flex: 1; min-width: 0; background: transparent; border: 0; color: var(--text); font: inherit; padding: .5rem 1rem; }
  .quick-check input:focus { outline: none; }
  .quick-check:focus-within { border-color: var(--blue); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .check-box > * { min-width: 0; }
  @media (max-width: 520px) { .quick-check { flex-direction: column; border-radius: 18px; } }
  .check-box { display: grid; gap: 2.5rem; grid-template-columns: 1.2fr 1fr; align-items: center; }
  .check-box .check-list { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.8rem; }
  @media (max-width: 900px) {
    .hero-grid, .check-box { grid-template-columns: 1fr; }
    .hero-visual { max-width: 420px; margin-inline: auto; }
  }
</style>
