---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import References from '../components/References.astro';
import Testimonials from '../components/Testimonials.astro';
import { references } from '../data/references';
const count = (s: string) => references.filter((r) => r.services.includes(s as never)).length;
const stats = [
  { n: references.length, l: 'Kundenprojekte live' },
  { n: count('logodesign'), l: 'Logos gestaltet' },
  { n: count('shop'), l: 'Online-Shops' },
  { n: 100, l: '% persönlich betreut' },
];
---
<Base title="Portfolio & Referenzen" description="Kundenprojekte der Webmanufaktur Schmitz aus Hilden: Logos, Websites und Online-Shops für Marken wie Cevdet Honig, Tragetraum und EXSTASE Energy.">
  <PageHero eyebrow="Portfolio" title="Projekte, die online sind." text="Von der Honigmarke bis zum Energy-Drink-Shop: Hier sehen Sie echte Kundenprojekte mit Logo, Website und Online-Shop. Fahren Sie mit der Maus über die Vorschau, um die ganze Seite zu sehen." />
  <section class="section section--alt">
    <div class="container stats">
      {stats.map((s) => <div class="stat"><b data-count={s.n}>{s.n}</b><span>{s.l}</span></div>)}
    </div>
  </section>
  <References title="Kundenprojekte" eyebrow="Referenzen" showAll={false} />
  <Testimonials />
  <CtaBand title="Ihr Projekt als nächste Referenz?" text="Erzählen Sie mir von Ihrem Vorhaben. Ich melde mich mit einer ehrlichen Einschätzung und einem Festpreis-Vorschlag." />
</Base>
<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .stat { text-align: center; padding: 1.4rem 1rem; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); }
  .stat b { display: block; font-family: var(--font-display); font-size: 2.6rem; line-height: 1; background: linear-gradient(120deg, #ffc24d, #ff4f8b 50%, #a45bff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stat span { display: block; margin-top: .4rem; color: var(--muted); font-size: .92rem; }
  @media (max-width: 760px) { .stats { grid-template-columns: 1fr 1fr; } }
</style>
