# Formular-Endpunkt (z. B. Formspree / Web3Forms). Ohne Wert öffnet das Formular das E-Mail-Programm (mailto).
PUBLIC_FORM_ENDPOINT=
# Google Tag Manager (z. B. GTM-XXXXXXX). Ohne Wert: kein Tracking, kein Cookie-Banner.
PUBLIC_GTM_ID=
# Google PageSpeed Insights API-Schlüssel (Google Cloud Console → APIs → PageSpeed Insights API). Ohne Schlüssel gilt ein kleines Kontingent.
PAGESPEED_API_KEY=
